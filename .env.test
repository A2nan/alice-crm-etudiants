# Variables d'environnement du banc de test.
#
# Ce fichier DOIT etre versionne : il ne contient aucun secret, et sans lui
# l'environnement `test` retombe sur le DATABASE_URL de .env, c'est-a-dire
# sur la base distante. Les tests suppriment des donnees (voir les setUp()
# de tests/Controller/), ils ne doivent jamais viser autre chose qu'une
# base locale jetable.
#
# Le suffixe _test est ajoute automatiquement par config/packages/doctrine.yaml.

KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
SYMFONY_DEPRECATIONS_HELPER=999999

# Base locale jetable. Identifiants alignes sur docker-compose.yml :
#   docker compose up -d database
DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=15&charset=utf8"

# Aucun mail ne doit partir depuis les tests
MAILER_DSN=null://null

# reCAPTCHA desactive : pas d'appel reseau sortant pendant les tests
RECAPTCHA3_KEY=
RECAPTCHA3_SECRET=
